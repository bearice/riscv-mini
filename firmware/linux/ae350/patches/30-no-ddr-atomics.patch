--- a/arch/riscv/include/asm/futex.h
+++ b/arch/riscv/include/asm/futex.h
@@ -12,6 +12,66 @@
 #include <linux/errno.h>
 #include <asm/asm.h>
 #include <asm/asm-extable.h>
+
+#ifndef CONFIG_SMP
+#include <linux/irqflags.h>
+
+static inline int
+arch_futex_atomic_op_inuser(int op, int oparg, int *oval, u32 __user *uaddr)
+{
+	int oldval = 0, ret = 0;
+	u32 val;
+	unsigned long flags;
+
+	if (!access_ok(uaddr, sizeof(u32)))
+		return -EFAULT;
+
+	raw_local_irq_save(flags);
+	if (__get_user(oldval, uaddr)) {
+		ret = -EFAULT;
+	} else {
+		switch (op) {
+		case FUTEX_OP_SET:  val = oparg; break;
+		case FUTEX_OP_ADD:  val = oldval + oparg; break;
+		case FUTEX_OP_OR:   val = oldval | oparg; break;
+		case FUTEX_OP_ANDN: val = oldval & ~oparg; break;
+		case FUTEX_OP_XOR:  val = oldval ^ oparg; break;
+		default: ret = -ENOSYS; break;
+		}
+		if (!ret && __put_user(val, uaddr))
+			ret = -EFAULT;
+	}
+	raw_local_irq_restore(flags);
+
+	if (!ret)
+		*oval = oldval;
+	return ret;
+}
+
+static inline int
+futex_atomic_cmpxchg_inatomic(u32 *uval, u32 __user *uaddr,
+			      u32 oldval, u32 newval)
+{
+	int ret = 0;
+	u32 val;
+	unsigned long flags;
+
+	if (!access_ok(uaddr, sizeof(u32)))
+		return -EFAULT;
+
+	raw_local_irq_save(flags);
+	if (__get_user(val, uaddr)) {
+		ret = -EFAULT;
+	} else if (val == oldval) {
+		if (__put_user(newval, uaddr))
+			ret = -EFAULT;
+	}
+	raw_local_irq_restore(flags);
+
+	*uval = val;
+	return ret;
+}
+#else
 
 /* We don't even really need the extable code, but for now keep it simple */
 #ifndef CONFIG_MMU
@@ -100,5 +160,6 @@
 	*uval = val;
 	return ret;
 }
+#endif /* CONFIG_SMP */
 
 #endif /* _ASM_RISCV_FUTEX_H */
