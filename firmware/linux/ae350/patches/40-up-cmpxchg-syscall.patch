+SYSCALL_DEFINE3(riscv_up_cmpxchg, u32 __user *, ptr, u32, oldval, u32, newval)
+{
+#ifdef CONFIG_SMP
+	return -ENOSYS;
+#else
+	u32 cur;
+	int ret;
+
+	if ((unsigned long)ptr & 3) {
+		force_sig_fault(SIGBUS, BUS_ADRALN, ptr);
+		return 0;
+	}
+	if (!access_ok(ptr, sizeof(u32))) {
+		force_sig_fault(SIGSEGV, SEGV_MAPERR, ptr);
+		return 0;
+	}
+	for (;;) {
+		preempt_disable();
+		pagefault_disable();
+		ret = __get_user(cur, ptr);
+		if (!ret && cur == oldval)
+			ret = __put_user(newval, ptr);
+		pagefault_enable();
+		preempt_enable();
+		if (!ret)
+			return (long)cur;
+		if (fault_in_writeable((char __user *)ptr, sizeof(u32))) {
+			force_sig_fault(SIGSEGV, SEGV_ACCERR, ptr);
+			return 0;
+		}
+	}
+#endif
+}
