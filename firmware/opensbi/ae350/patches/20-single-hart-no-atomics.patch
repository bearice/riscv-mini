+#ifdef SBI_NO_ATOMICS
+/* Library calls the compiler emits for __atomic/__sync builtins. */
+unsigned int __atomic_fetch_or_4(volatile void *ptr, unsigned int val,
+				 int order)
+{
+	volatile unsigned int *p = ptr;
+	unsigned int old = *p;
+
+	*p = old | val;
+	return old;
+}
+
+unsigned int __atomic_fetch_and_4(volatile void *ptr, unsigned int val,
+				  int order)
+{
+	volatile unsigned int *p = ptr;
+	unsigned int old = *p;
+
+	*p = old & val;
+	return old;
+}
+
+bool __atomic_compare_exchange_4(volatile void *ptr, void *expected,
+				 unsigned int desired, bool weak,
+				 int success, int failure)
+{
+	volatile unsigned int *p = ptr;
+	unsigned int *e = expected;
+	unsigned int old = *p;
+
+	if (old == *e) {
+		*p = desired;
+		return true;
+	}
+	*e = old;
+	return false;
+}
+#endif
