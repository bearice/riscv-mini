--- a/firmware/fw_base.S
+++ b/firmware/fw_base.S
@@ -42,8 +42,11 @@
 
 .macro CLEAR_MDT tmp
 #if __riscv_xlen == 32
-	li 	\tmp, MSTATUSH_MDT
-	csrc	CSR_MSTATUSH, \tmp
+	/*
+	 * Privileged 1.11 RV32 harts (Andes A25) have no mstatush and trap
