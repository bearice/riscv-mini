/*
 * Minimal build-time fallback DTB for the riscv-mini board
 * (TangPrimer 20K, VexRiscv RV32IMAF(C), S-mode under OpenSBI FW_PAYLOAD).
 *
 * CONFIG_OF_BOARD=y: at runtime U-Boot uses the DTB handed over by OpenSBI
 * (gd->arch.firmware_fdt_addr, 0x41080000). This file only satisfies the
 * build-time dtbs target.
 */

/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "riscv-mini";
	compatible = "riscv-mini";

	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <60000000>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "riscv";
			reg = <0>;
			riscv,isa = "rv32imafc";
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i", "m", "a", "f", "c";
			mmu-type = "riscv,none";
			i-cache-size = <16384>;
			d-cache-size = <16384>;
			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x07e00000>;
	};

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	soc: soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;
		bootph-all;

		uart0: serial@f000a000 {
			compatible = "riscv-mini,liteuart32";
			reg = <0xf000a000 0x100>;
			current-speed = <115200>;
			bootph-all;
		};
	};
};
