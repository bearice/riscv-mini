CONFIG_RISCV=y
CONFIG_TARGET_RISCV_MINI=y
CONFIG_RISCV_SMODE=y
CONFIG_RISCV_ISA_C=n
# Default board CPU is rv32ima: keep U-Boot integer-only so -mabi=ilp32
# matches the rv32im/ilp32 multilib libgcc (linked via PLATFORM_LIBGCC).
CONFIG_RISCV_ISA_F=n
CONFIG_RISCV_ISA_D=n
CONFIG_DEFAULT_DEVICE_TREE="riscv-mini"
CONFIG_OF_BOARD=y
CONFIG_TEXT_BASE=0x01100000
CONFIG_SYS_LOAD_ADDR=0x02000000
CONFIG_SYS_SDRAM_BASE=0x00000000
CONFIG_SYS_SDRAM_SIZE=0x07E00000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_STACKSIZE=0x400000
CONFIG_NR_DRAM_BANKS=1
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x07d00000
CONFIG_BAUDRATE=115200
CONFIG_SERIAL=y
CONFIG_DM_SERIAL=y
CONFIG_LITEUART32_SERIAL=y
CONFIG_TIMER=y
CONFIG_RISCV_TIMER=y
CONFIG_TIMER_EARLY=y
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_BASE=0xf000a800
CONFIG_DEBUG_UART_REGISTER_OFFSET=0
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_PRE_CONSOLE_BUFFER=y
CONFIG_PRE_CON_BUF_ADDR=0x07c00000
CONFIG_PRE_CON_BUF_SIZE=0x4000
CONFIG_SBI_V01=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_MMC=y
CONFIG_CMD_FAT=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_DOS_PARTITION=y
CONFIG_MMC=y
CONFIG_FAT_WRITE=y
CONFIG_FS_EXT4=y
CONFIG_SYS_LONGHELP=y
CONFIG_SYS_PROMPT="riscv-mini> "
CONFIG_HUSH_PARSER=y
CONFIG_INITRD_TAG=y
CONFIG_AUTOBOOT=y
CONFIG_BOOTDELAY=3
# The OpenSBI-embedded DTB is handed to the kernel unchanged; the kernel
# linear map covers it (no-map only skips 0x01000000..0x010fffff).
CONFIG_BOOT="fatload mmc 0:1 0x02000000 Image; booti 0x02000000 - 0x01080000"
CONFIG_LOG=y
CONFIG_SPL=n
CONFIG_LTO=n
# EFI_LOADER off: boot path is fatload+booti from SD; the bare-metal
# riscv64-elf ld lacks -shared support for boothart_efi.so.
CONFIG_EFI_LOADER=n
CONFIG_LOGLEVEL=4
CONFIG_CPU=y
CONFIG_CPU_RISCV=y
CONFIG_SYS_MALLOC_DEFAULT_TO_INIT=y

# Network (LiteEth EtherMAC)
CONFIG_NET=y
CONFIG_DM_ETH=y
CONFIG_CMD_NET=y
CONFIG_CMD_PING=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_LITEETH=y

# SD/MMC (LiteSDCard native host)
CONFIG_LITESD=y

# USB (custom PIO full-speed host)
CONFIG_EXCEPTION=y
CONFIG_CMD_USB=y
CONFIG_USB=y
CONFIG_USB_STORAGE=y
CONFIG_USB_LITEUSB=y

# RGB LCD framebuffer console, mirrored to UART.
CONFIG_VIDEO=y
CONFIG_VIDEO_RISCV_MINI_LCD=y
CONFIG_VIDEO_BPP16=y
CONFIG_VIDEO_BPP8=n
CONFIG_VIDEO_BPP32=n
CONFIG_CONSOLE_NORMAL=y
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_VIDEO_LOGO=n
CONFIG_CONSOLE_MUX=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_CMD_CONSOLE=y
