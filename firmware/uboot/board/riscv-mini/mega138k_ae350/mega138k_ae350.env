/* Load addresses are the OS handoff ranges of the AE350 address contract. */
#include <ae350_dts.h>

kernel_addr_r=AE350_OS_KERNEL_BASE
fdt_addr_r=AE350_OS_DTB_BASE
loadaddr=AE350_OS_KERNEL_BASE
bootfile=Image
fdtfile=mega138k_ae350.dtb
fdt_high=0xffffffff
/*
 * The BIOS FatFs writes these files and, like FatFs, a FAT boot sector at LBA 0
 * wins over the partition table. Each load prints its CRC32 so an unattended
 * boot leaves evidence of what it ran.
 */
sdboot=if fatinfo mmc 0:0; then setenv sdpart 0:0; else setenv sdpart 0; fi; fatload mmc ${sdpart} ${kernel_addr_r} ${bootfile} && crc32 ${kernel_addr_r} ${filesize} && fatload mmc ${sdpart} ${fdt_addr_r} ${fdtfile} && crc32 ${fdt_addr_r} ${filesize} && booti ${kernel_addr_r} - ${fdt_addr_r}
netboot=tftpboot ${kernel_addr_r} ${bootfile} && crc32 ${kernel_addr_r} ${filesize} && tftpboot ${fdt_addr_r} ${fdtfile} && crc32 ${fdt_addr_r} ${filesize} && booti ${kernel_addr_r} - ${fdt_addr_r}
