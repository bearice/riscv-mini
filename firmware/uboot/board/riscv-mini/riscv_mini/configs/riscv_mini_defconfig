CONFIG_RISCV=y
CONFIG_RISCV_SMODE=y
CONFIG_DEFAULT_DEVICE_TREE="u-boot"
CONFIG_OF_BOARD=y
CONFIG_SYS_TEXT_BASE=0x41100000
CONFIG_SYS_SDRAM_BASE=0x40000000
CONFIG_SYS_SDRAM_SIZE=0x07E00000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_STACKSIZE=0x400000
CONFIG_NR_DRAM_BANKS=1
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x47D00000
CONFIG_BAUDRATE=115200
CONFIG_SERIAL=y
CONFIG_DM_SERIAL=y
CONFIG_LITEUART32_SERIAL=y
CONFIG_TIMER=y
CONFIG_RISCV_TIMER=y
CONFIG_TIMER_EARLY=y
CONFIG_RISCV_SMODE_TIMER_FREQ=60000000
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_BASE=0xf000a000
CONFIG_DEBUG_UART_REGISTER_OFFSET=0
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_PRE_CONSOLE_BUFFER=y
CONFIG_SBI_V01=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_MMC=y
CONFIG_CMD_FAT=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_DOS_PARTITION=y
CONFIG_MMC=y
CONFIG_FAT_WRITE=y
CONFIG_FS_EXT4=y
CONFIG_SYS_LONGHELP=y
CONFIG_SYS_PROMPT="riscv-mini> "
CONFIG_HUSH_PARSER=y
CONFIG_INITRD_TAG=y
CONFIG_AUTOBOOT=y
CONFIG_BOOTDELAY=3
# The OpenSBI-embedded DTB is handed to the kernel unchanged; the kernel
# linear map covers it (no-map only skips 0x41000000..0x410fffff).
CONFIG_BOOT="fatload mmc 0:1 0x42000000 Image; booti 0x42000000 - 0x41080000"
CONFIG_LOG=y
CONFIG_SPL=n
CONFIG_LTO=n
CONFIG_POSITION_INDEPENDENT=n
